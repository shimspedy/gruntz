{
  "expo": {
    "name": "Gruntz",
    "slug": "gruntz",
    "scheme": "gruntz",
    "owner": "blaqdu",
    "version": "1.16.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gruntz.fitness",
      "appleTeamId": "YY96MFYC96",
      "buildNumber": "55",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMotionUsageDescription": "Gruntz uses motion sensors to count workout reps and steps during runs, rucks and hikes.",
        "NSLocationWhenInUseUsageDescription": "Gruntz uses your location to record the route, distance and pace of runs, rucks and hikes you start.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Allow Gruntz to record your active run, ruck or hike while the screen is locked or you use another app. Recording stops when you end the activity.",
        "NSSupportsLiveActivities": true
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.gruntz.fitness"
        ],
        "com.apple.developer.ubiquity-kvstore-identifier": "$(TeamIdentifierPrefix)$(CFBundleIdentifier)"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "predictiveBackGestureEnabled": true,
      "package": "com.gruntz.fitness",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_TOTAL_CALORIES_BURNED",
        "android.permission.health.READ_ELEVATION_GAINED",
        "android.permission.health.WRITE_EXERCISE",
        "android.permission.health.WRITE_DISTANCE",
        "android.permission.health.WRITE_ACTIVE_CALORIES_BURNED",
        "android.permission.health.WRITE_EXERCISE_ROUTE",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withReactCorePrebuiltEmbedFix",
      "./plugins/withSceneLifecycle",
      "./plugins/withOptionalCamera",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-notifications",
      "expo-secure-store",
      "expo-sensors",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Gruntz uses your location to record the route, distance and pace of runs, rucks and hikes you start.",
          "locationAlwaysAndWhenInUsePermission": "Allow Gruntz to record your active run, ruck or hike while the screen is locked or you use another app. Recording stops when you end the activity.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-font",
      "expo-video",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          },
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 26
          }
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Gruntz reads workouts and heart rate recorded by your watch or other apps so your runs, rucks and hikes show them in Activity history.",
          "NSHealthUpdateUsageDescription": "Gruntz saves the runs, rucks and hikes you record to Apple Health, with their distance, calories and route.",
          "background": false
        }
      ],
      "react-native-health-connect",
      [
        "expo-image-picker",
        {
          "photosPermission": "Gruntz uses your photo library only to set a profile photo you choose.",
          "cameraPermission": "Gruntz uses the camera only to take a profile photo."
        }
      ],
      "expo-sharing",
      "@maplibre/maplibre-react-native",
      "@bacons/apple-targets",
      "@sentry/react-native"
    ],
    "extra": {
      "eas": {
        "projectId": "6756ee93-6c12-45a9-90b3-85fc1c31cdcd"
      }
    }
  }
}
