{
  "expo": {
    "name": "Gruntz",
    "slug": "gruntz",
    "scheme": "gruntz",
    "owner": "blaqdu",
    "version": "1.8",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gruntz.fitness",
      "buildNumber": "30",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMotionUsageDescription": "Gruntz uses motion sensors to count your reps during workouts.",
        "NSLocationWhenInUseUsageDescription": "Gruntz uses your location to track runs and rucks."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "predictiveBackGestureEnabled": true,
      "package": "com.gruntz.fitness",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withReactCorePrebuiltEmbedFix",
      "./plugins/withSceneLifecycle",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-notifications",
      "expo-secure-store",
      "expo-sensors",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Gruntz uses your location to track runs and rucks."
        }
      ],
      "expo-font",
      "expo-video",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          },
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "6756ee93-6c12-45a9-90b3-85fc1c31cdcd"
      }
    }
  }
}
