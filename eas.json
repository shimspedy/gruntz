{
  "cli": {
    "version": ">= 15.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "buildConfiguration": "Release",
        "image": "macos-tahoe-26.6-xcode-27.1"
      },
      "env": {
        "SENTRY_ALLOW_FAILURE": "true"
      }
    },
    "release-simulator": {
      "extends": "production",
      "autoIncrement": false,
      "distribution": "internal",
      "environment": "production",
      "ios": {
        "simulator": true
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "johnnyhashim@gmail.com",
        "ascAppId": "6761699137",
        "appleTeamId": "YY96MFYC96"
      },
      "android": {
        "serviceAccountKeyPath": "./secrets/play-service-account.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
    },
    "closed-testing": {
      "android": {
        "serviceAccountKeyPath": "./secrets/play-service-account.json",
        "track": "alpha",
        "releaseStatus": "completed"
      }
    }
  }
}
