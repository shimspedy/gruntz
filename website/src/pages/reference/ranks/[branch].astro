---
import ToolPage from '../../../components/ToolPage.astro';
import { BRANCHES, type Branch, type Rank } from '../../../data/tools/types';
import { insigniaSvg, simplifiedEnlisted } from '../../../data/tools/insignia';
import { insigniaCredit, insigniaImage } from '../../../data/tools/insignia-images';
import * as data from '../../../data/tools/reference/ranks';

export function getStaticPaths() {
  return BRANCHES.filter((b) => data.ranks.some((r) => r.branch === b.id)).map((b) => ({ params: { branch: b.id } }));
}
const id = Astro.params.branch as Branch;
const branch = BRANCHES.find((b) => b.id === id)!;
const mine = data.ranks.filter((r) => r.branch === id);
const order = (r: Rank) => ({ enlisted: 0, warrant: 1, officer: 2 })[r.category] * 100 + Number(r.grade.split('-')[1]);
const groups = (['enlisted', 'warrant', 'officer'] as const)
  .map((c) => ({ c, list: mine.filter((r) => r.category === c).sort((a, b) => order(a) - order(b)) }))
  .filter((g) => g.list.length);
const label = { enlisted: 'Enlisted', warrant: 'Warrant officer', officer: 'Officer' };
const detailMods = import.meta.glob<{ rankDetails?: { branch: string; abbr: string; slug: string }[] }>('../../../data/tools/reference/rank-details/*.ts', { eager: true });
const details = Object.values(detailMods).flatMap((m) => m.rankDetails ?? []);
const detailHref = (r: Rank) => { const d = details.find((x) => x.branch === r.branch && x.abbr === r.abbr); return d ? `/reference/ranks/${r.branch}/${d.slug}/` : null; };
const anchor = (r: Rank) => `${r.grade}-${r.abbr}`.toLowerCase().replace(/[^a-z0-9]+/g, '-');
/** The main title at the same grade in each other branch (billets and historical ranks left out). */
/** One-of-a-kind posts (service senior enlisted advisors) and historical five-star grades. */
const isBillet = (r: Rank) => r.grade === 'O-11' || /advisor billet|historical|five-star/i.test(r.note ?? '');
const equivalents = (r: Rank) => BRANCHES.filter((b) => b.id !== id).map((b) => {
  const pool = data.ranks.filter((x) => x.branch === b.id && x.grade === r.grade && !isBillet(x));
  return pool.length ? { branch: b, ranks: pool } : null;
}).filter((x): x is { branch: (typeof BRANCHES)[number]; ranks: Rank[] } => !!x);
const top = mine.filter((r) => r.category === 'enlisted').sort((a, b) => order(b) - order(a))[0];
---

<ToolPage
  metaTitle={`${branch.short} Ranks in Order: Insignia and Pay Grades`.slice(0, 60)}
  description={`All ${branch.name} ranks in order, from ${mine[0]?.title ?? 'E-1'} to the top officer grade, with insignia, pay grade, abbreviation and equivalent ranks.`.slice(0, 155)}
  h1={`${branch.short} ranks`}
  lede={`Every ${branch.name} rank from the newest ${branch.member.toLowerCase()} to the highest officer, with its insignia, pay grade and the equal rank in each other service.`}
  crumbs={[{ name: 'Reference', href: '/tools/' }, { name: 'Military ranks', href: '/reference/ranks/' }, { name: branch.short, href: `/reference/ranks/${id}/` }]}
  provenance={data.provenance}
  faq={[
    { q: `How many ranks are in the ${branch.short}?`, a: `${mine.length} titles are listed on this page, across ${groups.map((g) => label[g.c].toLowerCase()).join(', ')} ranks. Some pay grades have more than one title.` },
    ...(top ? [{ q: `What is the highest enlisted rank in the ${branch.short}?`, a: `${top.title} (${top.abbr}), pay grade ${top.grade}.` }] : []),
    { q: 'Are these the official insignia images?', a: 'Yes, where the Department of War publishes one. A few ranks without a published image show a simplified drawing instead.' },
  ]}
  related={[{ name: 'All branches compared', href: '/reference/ranks/' }, { name: 'Military pay chart', href: '/reference/military-pay-chart/' }, ...BRANCHES.filter((b) => b.id !== id).map((b) => ({ name: `${b.short} ranks`, href: `/reference/ranks/${b.id}/` }))].slice(0, 8)}
>
  <nav aria-label="Rank groups" class="flex flex-wrap gap-2">
    {groups.map((g) => <a href={`#${g.c}`} class="rounded-full border border-bone/15 px-4 py-2 text-[14px] text-bone-2 transition-colors duration-150 hover:border-bone/40 hover:text-bone">{label[g.c]} <span class="text-bone-3">{g.list.length}</span></a>)}
  </nav>

  {groups.map((g) => (
    <section class="mt-14 scroll-mt-24" id={g.c} aria-labelledby={`${g.c}-h`}>
      <h2 id={`${g.c}-h`} class="text-[28px] font-bold leading-tight [font-stretch:112%]">{label[g.c]} ranks</h2>
      <ol class="mt-6 grid gap-3 md:grid-cols-2 xl:grid-cols-3">
        {g.list.map((r) => {
          const photo = insigniaImage(r.branch, r.abbr);
          const art = photo ? null : insigniaSvg(r);
          const eq = equivalents(r);
          return (
            <li id={anchor(r)} class="scroll-mt-24 rounded-2xl border border-bone/10 bg-ink-2 p-5">
              <div class="flex items-start gap-4">
                <div class="grid h-[88px] w-[88px] shrink-0 place-items-center rounded-xl bg-ink-3 p-2">
                  {photo ? <img src={photo} alt={`${r.title} insignia`} width="72" height="72" loading="lazy" decoding="async" class="h-[72px] w-[72px] object-contain" />
                    : art ? <div class="h-full w-full [&_svg]:h-full [&_svg]:w-full" set:html={art} /> : <span class="px-1 text-center text-[12px] leading-4 text-bone-3">No insignia</span>}
                </div>
                <div class="min-w-0">
                  <p class="font-mono text-[13px] text-accent-text tabular-nums">{r.grade} · {r.abbr}</p>
                  <h3 class="mt-1 text-[19px] font-semibold leading-snug [font-stretch:108%]">{detailHref(r) ? <a href={detailHref(r)} class="hover:text-accent-text">{r.title}</a> : r.title}</h3>
                  {r.note ? <p class="mt-1 text-[13px] leading-5 text-bone-3">{r.note}</p> : null}
                </div>
              </div>
              <p class="mt-4 text-[15px] leading-relaxed text-bone-2">{r.insignia}</p>
              {detailHref(r) ? <a href={detailHref(r)} class="mt-3 inline-flex items-center gap-1.5 text-[14px] font-semibold text-accent-text hover:text-bone">Role, promotion and history <span aria-hidden="true">→</span></a> : null}
              {eq.length && !isBillet(r) ? (
                <div class="mt-4 border-t border-bone/10 pt-3">
                  <p class="text-[12px] text-bone-3">Same grade in other services</p>
                  <ul class="mt-2 flex flex-wrap gap-1.5">
                    {eq.flatMap(({ branch: b, ranks }) => ranks.map((rank) => (
                      <li><a href={`/reference/ranks/${b.id}/#${anchor(rank)}`} class="inline-flex items-center gap-1.5 rounded-full bg-ink-3 px-2.5 py-1 text-[12px] text-bone-2 transition-colors duration-150 hover:text-bone" title={rank.title}><span class="text-bone-3">{b.short}</span> {rank.abbr}</a></li>
                    )))}
                  </ul>
                </div>
              ) : null}
            </li>
          );
        })}
      </ol>
    </section>
  ))}

  <p class="mt-12 max-w-[72ch] text-sm leading-relaxed text-bone-3">
    <a href={insigniaCredit.url} target="_blank" rel="noopener" class="underline decoration-1 underline-offset-[3px] hover:text-bone">{insigniaCredit.label}</a>. Use of these images does not imply endorsement by the Department or any military branch.
    {mine.some((r) => !insigniaImage(r.branch, r.abbr) && insigniaSvg(r)) ? ' Ranks without an official image show a simplified drawing.' : ''}
  </p>
</ToolPage>
