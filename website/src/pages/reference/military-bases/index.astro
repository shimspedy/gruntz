---
import ToolPage from '../../../components/ToolPage.astro';
import BaseList from '../../../components/BaseList.astro';
import { BRANCHES } from '../../../data/tools/types';
import { installations, provenance } from '../../../data/tools/reference/installations';
const count = installations.length;
---
<ToolPage
  metaTitle="U.S. Military Bases List by State and Branch"
  description={`List of ${count} U.S. military bases and installations for every branch, by state and country, with what each one is home to.`}
  h1="U.S. military bases by state"
  lede="Major Army, Marine Corps, Navy, Air Force, Space Force and Coast Guard installations at home and overseas, with a line on what each is known for."
  crumbs={[{ name: 'Reference', href: '/tools/' }, { name: 'Military bases', href: '/reference/military-bases/' }]}
  provenance={provenance}
  faq={[
    { q: 'How many military bases are listed here?', a: `${count} installations. Small sites such as recruiting stations and reserve centers are not included.` },
    { q: 'What is a joint base?', a: 'An installation run by one branch that hosts units from several. The branch shown is the one that runs it, or “Joint” where the services share it.' },
  ]}
  related={BRANCHES.filter((b) => installations.some((i) => i.branch === b.id)).map((b) => ({ name: `${b.short} bases`, href: `/reference/military-bases/${b.id}/` }))}
>
  <BaseList list={installations} />
</ToolPage>
