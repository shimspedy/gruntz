---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import GuideCard from '../../components/GuideCard.astro';
import DownloadCta from '../../components/DownloadCta.astro';
import { site } from '../../data/site';
import { testGuides, trainingGuides } from '../../data/guides';

const title = 'Military Training Guides: Run, Ruck, Pull-Ups and More';
const description = 'Free training plans for military fitness: boot camp prep, ruck marches, pull-ups, the 2-mile run, planks and hand-release push-ups.';
const url = new URL('/training/', site.url).toString();
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'CollectionPage', name: title, description, url, inLanguage: 'en',
    hasPart: trainingGuides.map((g) => ({ '@type': 'Article', headline: g.h1, url: new URL(`/training/${g.slug}/`, site.url).toString() })),
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Training', item: url },
    ],
  },
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <Header />
  <main id="main">
    <section class="border-b border-bone/10">
      <div class="shell py-16 md:py-24">
        <p class="stamp">Training guides</p>
        <h1 class="display mt-5 max-w-[16ch] text-[36px] sm:text-[48px] lg:text-[72px]">Training plans for the events that count</h1>
        <p class="mt-6 max-w-[60ch] text-lg leading-relaxed text-bone-2">
          Week-by-week plans for the work military fitness tests keep asking for: running, rucking, pull-ups, push-ups and planks. Written to be followed, with sets, distances and progressions.
        </p>
      </div>
    </section>

    <section class="shell py-16 md:py-20" aria-labelledby="guides-title">
      <h2 id="guides-title" class="display text-[28px] md:text-[36px]">Pick a plan</h2>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {trainingGuides.map((g) => <li><GuideCard guide={g} /></li>)}
      </ul>
    </section>

    <section class="border-t border-bone/10 bg-ink-2" aria-labelledby="tests-title">
      <div class="shell py-16 md:py-20">
        <h2 id="tests-title" class="display text-[28px] md:text-[36px]">Training for a specific test</h2>
        <p class="mt-5 max-w-[60ch] text-lg leading-relaxed text-bone-2">Each test guide lists the events in order, explains the scoring and links to the official chart.</p>
        <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {testGuides.map((g) => <li><GuideCard guide={g} /></li>)}
        </ul>
        <p class="mt-10 max-w-[80ch] text-sm leading-relaxed text-bone-3">
          These guides are general training information, not medical advice. Gruntz is an independent app built by a former U.S. Marine and is not affiliated with or endorsed by the U.S. Department of Defense or any military branch.
        </p>
      </div>
    </section>

    <DownloadCta
      placement="training-hub"
      title="Put the plan on your phone"
      sub="Follow a program or build your own sessions, log every set, and keep your training history in one place."
    />
  </main>
  <Footer />
</BaseLayout>
