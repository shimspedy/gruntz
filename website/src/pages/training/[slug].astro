---
import GuidePage from '../../components/GuidePage.astro';
import { trainingGuides } from '../../data/guides';
import type { Guide } from '../../data/guides/types';

export function getStaticPaths() {
  return trainingGuides.map((guide) => ({ params: { slug: guide.slug }, props: { guide } }));
}
const { guide } = Astro.props as { guide: Guide };
---
<GuidePage guide={guide} />
