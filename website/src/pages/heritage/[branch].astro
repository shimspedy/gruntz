---
import ToolPage from '../../components/ToolPage.astro';
import { BRANCHES, type Branch, type Heritage } from '../../data/tools/types';

const modules = import.meta.glob<{ heritage: Heritage }>('../../data/tools/heritage/*.ts', { eager: true });
export function getStaticPaths() {
  const mods = import.meta.glob<{ heritage?: unknown }>('../../data/tools/heritage/*.ts', { eager: true });
  return BRANCHES.filter((b) => mods[`../../data/tools/heritage/${b.id}.ts`]?.heritage).map((b) => ({ params: { branch: b.id } }));
}
const id = Astro.params.branch as Branch;
const branch = BRANCHES.find((b) => b.id === id)!;
const h = modules[`../../data/tools/heritage/${id}.ts`].heritage;
const current = h.leaders.list.find((l) => l.to === null);
const cats = ['aircraft', 'vehicle', 'vessel', 'weapon', 'spacecraft'] as const;
const catLabel = { aircraft: 'Aircraft', vehicle: 'Vehicles', vessel: 'Ships and boats', weapon: 'Weapons', spacecraft: 'Satellites and spacecraft' };
const years = (from: number, to: number | null) => `${from}–${to ?? 'present'}`;
---

<ToolPage
  metaTitle={`${branch.short} History, Leaders and Equipment`}
  description={`${branch.name} history from ${h.founded.split(/[,(]/)[0].trim()} to today: key moments, every ${h.leaders.title.toLowerCase()}, notable members and equipment in service.`.slice(0, 155)}
  h1={`${branch.name} history`}
  lede={h.overview}
  crumbs={[{ name: 'Heritage', href: '/tools/' }, { name: branch.short, href: `/heritage/${id}/` }]}
  provenance={h.provenance}
  faq={[
    { q: `When was the ${branch.name} founded?`, a: h.founded },
    { q: `What is the ${branch.short} motto?`, a: h.motto },
    ...(current ? [{ q: `Who is the current ${h.leaders.title}?`, a: `${current.name}, since ${current.from}.` }] : []),
  ]}
  related={BRANCHES.filter((b) => b.id !== id).map((b) => ({ name: `${b.short} history`, href: `/heritage/${b.id}/` }))}
>
  <nav aria-label="On this page" class="flex flex-wrap gap-2">
    {[['timeline', 'Timeline'], ['leaders', h.leaders.title + 's'], ['notable', 'Notable members'], ['equipment', 'Equipment']].map(([href, name]) => (
      <a href={`#${href}`} class="rounded-full border border-bone/15 px-4 py-2 text-[14px] text-bone-2 transition-colors duration-150 hover:border-bone/40 hover:text-bone">{name}</a>
    ))}
  </nav>

  <dl class="mt-10 grid max-w-[72ch] gap-px overflow-hidden rounded-2xl border border-bone/10 bg-bone/10 sm:grid-cols-2">
    <div class="bg-ink-2 p-5"><dt class="text-sm text-bone-3">Founded</dt><dd class="mt-1 text-[17px] font-semibold">{h.founded}</dd></div>
    <div class="bg-ink-2 p-5"><dt class="text-sm text-bone-3">Motto</dt><dd class="mt-1 text-[17px] font-semibold">{h.motto}</dd></div>
  </dl>

  <section class="mt-16 max-w-[72ch]" aria-labelledby="timeline">
    <h2 id="timeline" class="text-[28px] font-bold leading-tight [font-stretch:112%]">Timeline</h2>
    <ol class="mt-6 border-l border-bone/15">
      {[...h.timeline].sort((a, b) => a.year - b.year).map((e) => (
        <li class="relative pb-6 pl-6 before:absolute before:left-[-5px] before:top-2 before:h-2.5 before:w-2.5 before:rounded-full before:bg-accent">
          <p class="font-mono text-[14px] text-accent-text tabular-nums">{e.year}</p>
          <p class="mt-1 text-[16px] leading-relaxed text-bone-2">{e.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="mt-14" aria-labelledby="leaders">
    <h2 id="leaders" class="text-[28px] font-bold leading-tight [font-stretch:112%]">Every {h.leaders.title}</h2>
    <div class="mt-5 max-w-[720px] overflow-x-auto rounded-2xl border border-bone/10 bg-ink-2">
      <table class="chart w-full text-[15px]">
        <thead><tr><th scope="col">#</th><th scope="col">Name</th><th scope="col">Served</th></tr></thead>
        <tbody>{h.leaders.list.map((l, i) => <tr><th scope="row" class="tabular-nums">{i + 1}</th><td class="whitespace-normal text-bone">{l.name}{l.note ? <span class="block text-[13px] text-bone-3">{l.note}</span> : null}</td><td class="tabular-nums">{years(l.from, l.to)}</td></tr>)}</tbody>
      </table>
    </div>
  </section>

  <section class="mt-14" aria-labelledby="notable">
    <h2 id="notable" class="text-[28px] font-bold leading-tight [font-stretch:112%]">Notable {branch.member.toLowerCase()}s</h2>
    <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {h.notable.map((p) => (
        <li class="rounded-2xl border border-bone/10 bg-ink-2 p-5">
          <p class="text-[17px] font-semibold">{p.name}</p>
          <p class="mt-0.5 font-mono text-[13px] text-bone-3">{p.years}</p>
          <p class="mt-3 text-[15px] leading-relaxed text-bone-2">{p.knownFor}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="mt-14" aria-labelledby="equipment">
    <h2 id="equipment" class="text-[28px] font-bold leading-tight [font-stretch:112%]">Equipment in service</h2>
    {cats.map((c) => {
      const list = h.equipment.filter((e) => e.category === c);
      return list.length ? (
        <div class="mt-8">
          <h3 class="text-[19px] font-semibold">{catLabel[c]}</h3>
          <div class="mt-3 overflow-x-auto rounded-2xl border border-bone/10 bg-ink-2">
            <table class="chart w-full text-[15px]">
              <tbody>{list.map((e) => <tr><th scope="row" class="w-64 whitespace-normal">{e.name}</th><td class="whitespace-normal">{e.role}</td></tr>)}</tbody>
            </table>
          </div>
        </div>
      ) : null;
    })}
  </section>
</ToolPage>
