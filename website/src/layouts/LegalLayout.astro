---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  kicker?: string;
  updated?: string;
}

const { title, description, kicker = 'Legal', updated = site.updated } = Astro.props as Props;
---

<BaseLayout title={`${title} | ${site.name}`} description={description}>
  <Header />
  <main id="main">
    <section class="border-b border-bone/10">
      <div class="shell py-16 md:py-24">
        <p class="stamp">{kicker} · Last updated {updated}</p>
        <h1 class="display mt-4 max-w-[18ch] text-[40px] md:text-[64px]">{title}</h1>
        <p class="mt-6 max-w-[62ch] text-lg leading-relaxed text-bone-2">{description}</p>
      </div>
    </section>

    <section class="shell py-16">
      <article class="prose-g max-w-[72ch]">
        <slot />
      </article>
    </section>
  </main>
  <Footer />
</BaseLayout>
