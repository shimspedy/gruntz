---
import { site } from '../data/site';
import { content, type Lang } from '../i18n/content';
import { buttonVariants } from './ui/button';

interface Props {
  lang?: Lang;
  title: string;
  sub: string;
  cta?: string;
  placement: string;
}
const { lang = 'en', title, sub, cta, placement } = Astro.props as Props;
const t = content[lang];
const label = cta ?? (lang === 'es' ? 'Descargar Gruntz' : 'Download Gruntz');
---

<section class="border-t border-bone/10 bg-ink-2">
  <div class="shell grid items-center gap-10 py-20 md:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] md:py-24">
    <div>
      <h2 class="display max-w-[16ch] text-[36px] md:text-[56px]">{title}</h2>
      <p class="mt-5 max-w-[48ch] text-lg leading-relaxed text-bone-2">{sub}</p>
    </div>
    <div class="md:justify-self-end">
      <div class="flex flex-wrap items-center gap-4">
        <a class={buttonVariants({ size: 'lg' })} href={site.appStoreUrl} target="_blank" rel="noopener" data-cta={placement}>{label}</a>
        <a href={site.appStoreUrl} target="_blank" rel="noopener" class="inline-flex" data-cta={`${placement}-badge`}>
          <img src="/brand/app-store-badge.svg" alt={t.hero.badgeAlt} width="144" height="48" loading="lazy" />
        </a>
      </div>
      <p class="mt-5 max-w-[44ch] text-sm leading-relaxed text-bone-3">{t.cta.fine}</p>
    </div>
  </div>
</section>
