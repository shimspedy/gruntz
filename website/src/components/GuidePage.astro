---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Blocks from './Blocks.astro';
import GuideCard from './GuideCard.astro';
import DownloadCta from './DownloadCta.astro';
import Faq from './react/Faq';
import { site } from '../data/site';
import { guideByKey } from '../data/guides';
import { guidePath, inline, plain, type Guide } from '../data/guides/types';
import { guidePhotos } from '../data/photos';

interface Props { guide: Guide; }
const { guide } = Astro.props as Props;

const isTest = guide.kind === 'test';
const section = isTest
  ? { name: 'Fitness tests', href: '/fitness-tests/' }
  : { name: 'Training', href: '/training/' };
const url = new URL(guidePath(guide), site.url).toString();
const verified = new Date(`${guide.verified}T12:00:00Z`).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const related = guide.related.map(guideByKey).filter((g): g is Guide => Boolean(g));
const faqItems = guide.faq.map((f) => ({ q: f.q, a: inline(f.a) }));
const photo = guidePhotos[guide.slug];

const publisher = { '@type': 'Organization', name: site.name, url: site.url, logo: new URL('/brand/gruntz-icon.png', site.url).toString() };
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'Article', headline: guide.h1, description: guide.description,
    mainEntityOfPage: url, datePublished: '2026-11-17', dateModified: guide.verified, inLanguage: 'en',
    author: { ...publisher, description: 'Independent military fitness app built by a former U.S. Marine.' }, publisher,
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
      { '@type': 'ListItem', position: 2, name: section.name, item: new URL(section.href, site.url).toString() },
      { '@type': 'ListItem', position: 3, name: guide.name, item: url },
    ],
  },
  {
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: guide.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: plain(f.a) } })),
  },
];
---

<BaseLayout title={guide.metaTitle} description={guide.description} ogType="article" jsonLd={jsonLd}>
  <Header />
  <main id="main">
    <article>
      <header class="border-b border-bone/10">
        <div class="shell grid gap-10 py-12 md:py-20 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:items-end lg:gap-16">
          <div>
            <nav aria-label="Breadcrumb" class="stamp">
              <ol class="flex flex-wrap gap-x-2">
                <li><a class="hover:text-bone" href="/">Home</a> <span aria-hidden="true">/</span></li>
                <li><a class="hover:text-bone" href={section.href}>{section.name}</a> <span aria-hidden="true">/</span></li>
                <li aria-current="page" class="text-bone-2">{guide.name}</li>
              </ol>
            </nav>
            <h1 class="display mt-6 max-w-[20ch] text-[34px] sm:text-[44px] lg:text-[56px]">{guide.h1}</h1>
            <p class="mt-6 max-w-[58ch] text-lg leading-relaxed text-bone-2">{guide.lede}</p>
            <p class="stamp mt-6">Last verified {verified}{isTest ? ' · Confirm current standards with your service' : ''}</p>
          </div>
          <dl class="grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-bone/10 bg-bone/10">
            {guide.facts.map((fact) => (
              <div class="flex flex-col-reverse justify-end gap-2 bg-ink-2 p-5">
                <dt class="text-sm leading-5 text-bone-3">{fact.label}</dt>
                <dd class="text-xl font-semibold leading-tight [font-stretch:112%]">{fact.value}</dd>
              </div>
            ))}
          </dl>
        </div>
        {photo ? (
          <div class="shell pb-12 md:pb-16">
            <Image src={photo.src} alt={photo.alt} widths={[640, 960, 1280, 1920]} sizes="(max-width: 1328px) calc(100vw - 48px), 1280px" format="webp" quality={72} loading="eager" fetchpriority="high" class="aspect-[16/9] w-full rounded-[20px] object-cover md:aspect-[21/9]" style={`object-position:${photo.pos ?? '50% 50%'}`} />
            {photo.credit ? <p class="mt-3 text-[13px] leading-5 text-bone-3">{photo.credit}</p> : null}
          </div>
        ) : null}
      </header>

      <div class="shell grid gap-12 py-12 md:py-16 lg:grid-cols-[240px_minmax(0,1fr)] lg:gap-16">
        <nav aria-label="On this page" class="lg:sticky lg:top-24 lg:self-start">
          <p class="stamp">On this page</p>
          <ol class="mt-4 grid gap-1 border-l border-bone/10">
            {guide.sections.map((s) => (
              <li><a href={`#${s.id}`} class="-ml-px block border-l border-transparent py-1.5 pl-4 text-[15px] leading-snug text-bone-2 transition-colors duration-150 ease-out hover:border-bone/40 hover:text-bone">{s.title}</a></li>
            ))}
            <li><a href="#faq" class="-ml-px block border-l border-transparent py-1.5 pl-4 text-[15px] leading-snug text-bone-2 transition-colors duration-150 ease-out hover:border-bone/40 hover:text-bone">Questions</a></li>
          </ol>
        </nav>

        <div class="min-w-0">
          <div class="prose-g max-w-[72ch] [&>h2:first-child]:mt-0">
            {guide.sections.map((s) => (
              <Fragment>
                <h2 id={s.id}>{s.title}</h2>
                <Blocks blocks={s.blocks} />
              </Fragment>
            ))}
          </div>

          <section id="faq" class="mt-16 max-w-[72ch] scroll-mt-24" aria-labelledby="faq-title">
            <h2 id="faq-title" class="text-[28px] font-bold leading-tight [font-stretch:112%]">Questions</h2>
            <div class="prose-faq mt-6" data-island="faq" data-props={JSON.stringify({ items: faqItems })}>
              <Faq items={faqItems} />
            </div>
          </section>

          {guide.sources.length > 0 ? (
            <section class="mt-16 max-w-[72ch] rounded-2xl border border-bone/10 bg-ink-2 p-6" aria-labelledby="sources-title">
              <h2 id="sources-title" class="text-lg font-semibold">Official sources</h2>
              <ul class="mt-4 grid gap-3">
                {guide.sources.map((source) => (
                  <li><a href={source.url} target="_blank" rel="noopener" class="text-[15px] text-accent-text underline decoration-1 underline-offset-[3px] hover:text-bone">{source.label}</a></li>
                ))}
              </ul>
              <p class="mt-5 text-sm leading-relaxed text-bone-3">Standards change. Your command and the official publications above are the authority, not this page.</p>
            </section>
          ) : null}

          <p class="mt-8 max-w-[72ch] text-sm leading-relaxed text-bone-3">
            Gruntz is an independent training app built by a former U.S. Marine. It is not affiliated with or endorsed by the U.S. Department of Defense or any military branch.
          </p>
        </div>
      </div>
    </article>

    {related.length > 0 ? (
      <section class="border-t border-bone/10" aria-labelledby="related-title">
        <div class="shell py-16 md:py-20">
          <h2 id="related-title" class="display text-[28px] md:text-[36px]">Keep going</h2>
          <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {related.map((g) => <li><GuideCard guide={g} /></li>)}
          </ul>
        </div>
      </section>
    ) : null}

    <DownloadCta
      placement="guide"
      title={isTest ? 'Log your test events in Gruntz' : 'Put the plan on your phone'}
      sub={isTest
        ? 'Save each event result, compare progress checks, and see which event sits furthest from your own target. A preparation benchmark, not an official score.'
        : 'Follow a program or build your own sessions, log every set, and keep your training history in one place.'}
    />
  </main>
  <Footer />
</BaseLayout>
