---
import { guidePath, type Guide } from '../data/guides/types';
interface Props { guide: Guide; }
const { guide } = Astro.props as Props;
---
<a
  href={guidePath(guide)}
  class="group flex h-full flex-col justify-between gap-8 rounded-2xl border border-bone/10 bg-ink-2 p-6 transition-colors duration-150 ease-out hover:border-bone/25 hover:bg-ink-3"
>
  <div>
    <p class="stamp">{guide.kind === 'test' ? guide.branch : 'Training guide'}</p>
    <h3 class="mt-3 text-xl font-semibold leading-snug [font-stretch:112%]">{guide.name}</h3>
    <p class="mt-2 text-[15px] leading-relaxed text-bone-2">{guide.summary}</p>
  </div>
  <span class="inline-flex items-center gap-2 text-sm font-semibold text-accent-text">
    Read the guide
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="transition-transform duration-150 ease-out group-hover:translate-x-1"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
  </span>
</a>
