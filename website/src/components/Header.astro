---
import { site } from '../data/site';
import { content, languages, localePath, type Lang } from '../i18n/content';
import MobileNav from './react/MobileNav';
import { buttonVariants } from './ui/button';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props as Props;
const t = content[lang].nav;
const es = lang === 'es';

// Build output uses directory URLs (/support/), so compare without the trailing slash.
const path = Astro.url.pathname.replace(/(.)\/$/, '$1');

// Guides and legal pages are English-only, so they stay unprefixed in both languages.
const links = [
  { label: t.features, href: localePath(lang, '/#features') },
  { label: es ? 'Pruebas físicas' : 'Fitness tests', href: '/fitness-tests/' },
  { label: es ? 'Entrenamiento' : 'Training', href: '/training/' },
  { label: es ? 'Herramientas' : 'Tools', href: '/tools/' },
  { label: es ? 'Cómics' : 'Comics', href: localePath(lang, '/#comics') },
  { label: t.support, href: '/support' },
];
const isCurrent = (href: string) => {
  const target = href.replace(/(.)\/$/, '$1');
  return !target.includes('#') && (path === target || path.startsWith(`${target}/`));
};

// The language switch always lands on the matching homepage.
const langs = (Object.keys(languages) as Lang[]).map((l) => ({
  code: l,
  label: languages[l],
  href: localePath(l, '/'),
  current: l === lang,
}));
const navProps = {
  links,
  cta: { label: es ? 'Descargar Gruntz' : 'Download Gruntz', href: site.appStoreUrl },
  langs,
  labels: es
    ? { open: 'Abrir menú', close: 'Cerrar menú', title: 'Menú', language: t.language }
    : { open: 'Open menu', close: 'Close menu', title: 'Menu', language: t.language },
};
---

<header class="sticky top-0 z-40 border-b border-bone/10 bg-ink/95">
  <div class="shell flex h-16 items-center justify-between gap-6">
    <a class="flex items-center gap-2.5" href={localePath(lang, '/')} aria-label="Gruntz">
      <img src="/brand/gruntz-icon.png" alt="" width="32" height="32" class="size-8 rounded-lg" />
      <span class="display text-lg">Gruntz</span>
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Primary">
      {links.map((link) => (
        <a
          href={link.href}
          aria-current={isCurrent(link.href) ? 'page' : undefined}
          class="whitespace-nowrap text-[15px] font-medium text-bone-2 transition-colors duration-150 ease-out hover:text-bone aria-[current=page]:text-bone"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <div class="hidden items-center lg:flex" role="group" aria-label={t.language}>
        {langs.map((l) => (
          <a
            href={l.href}
            hreflang={l.code}
            lang={l.code}
            aria-current={l.current ? 'true' : undefined}
            class="stamp inline-flex h-9 min-w-9 items-center justify-center rounded-full px-2 transition-colors duration-150 ease-out hover:text-bone aria-[current=true]:text-bone"
          >
            {l.label}
          </a>
        ))}
      </div>
      <button type="button" data-theme-toggle aria-label="Theme: system. Switch to light" class="theme-toggle inline-flex size-9 items-center justify-center rounded-full text-bone-2 transition-colors duration-150 ease-out hover:bg-ink-3 hover:text-bone">
        <svg class="i-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2.2M12 19.3v2.2M4.6 4.6l1.6 1.6M17.8 17.8l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.6 19.4l1.6-1.6M17.8 6.2l1.6-1.6"/></svg>
        <svg class="i-system" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="12.5" rx="2"/><path d="M8.5 20.5h7M12 16.5v4"/></svg>
        <svg class="i-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 14.2A8.5 8.5 0 1 1 9.8 3.5a6.8 6.8 0 0 0 10.7 10.7Z"/></svg>
      </button>
      <a class={`${buttonVariants({ size: 'sm' })} max-lg:hidden`} href={site.appStoreUrl} target="_blank" rel="noopener" data-cta="header">{t.download}</a>
      <div data-island="nav" data-props={JSON.stringify(navProps)} class="lg:hidden">
        <MobileNav {...navProps} />
      </div>
    </div>
  </div>
</header>
