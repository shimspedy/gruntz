---
import type { Installation } from '../data/tools/types';
import { BRANCHES } from '../data/tools/types';
interface Props { list: Installation[]; showBranch?: boolean }
const { list, showBranch = true } = Astro.props as Props;
const places = [...new Set(list.map((i) => i.state))].sort((a, b) => a.localeCompare(b));
const name = (b: Installation['branch']) => (b === 'joint' ? 'Joint' : BRANCHES.find((x) => x.id === b)?.short ?? b);
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---
<nav aria-label="States and countries" class="max-w-[80ch]">
  <p class="stamp">Jump to a state or country</p>
  <ul class="mt-3 flex flex-wrap gap-2">
    {places.map((p) => <li><a href={`#${slug(p)}`} class="inline-block rounded-full border border-bone/15 px-3 py-1.5 text-[13px] text-bone-2 transition-colors duration-150 hover:border-bone/40 hover:text-bone">{p}</a></li>)}
  </ul>
</nav>
{places.map((p) => (
  <section class="mt-10" id={slug(p)} aria-labelledby={`h-${slug(p)}`}>
    <h2 id={`h-${slug(p)}`} class="text-[22px] font-bold leading-tight [font-stretch:112%]">{p}</h2>
    <div class="mt-3 overflow-x-auto rounded-2xl border border-bone/10 bg-ink-2">
      <table class="chart w-full text-[15px]">
        <thead><tr><th scope="col">Installation</th>{showBranch ? <th scope="col">Branch</th> : null}<th scope="col">Location</th><th scope="col">What is there</th></tr></thead>
        <tbody>{list.filter((i) => i.state === p).sort((a, b) => a.name.localeCompare(b.name)).map((i) => (
          <tr><th scope="row" class="whitespace-normal">{i.name}</th>{showBranch ? <td>{name(i.branch)}</td> : null}<td>{i.city}</td><td class="min-w-[280px] whitespace-normal">{i.summary}</td></tr>
        ))}</tbody>
      </table>
    </div>
  </section>
))}
