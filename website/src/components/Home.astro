---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import ComicGallery from './ComicGallery.astro';
import { Image } from 'astro:assets';
import fieldPhoto from '../assets/photos/p39.jpg';
import { site } from '../data/site';
import { content, type Lang } from '../i18n/content';
interface Props { lang: Lang; }
const { lang } = Astro.props as Props;
const t = content[lang];
const es = lang === 'es';
const c = es ? {
  issue: 'TU PLAN DIARIO', intro: 'Una app de fitness militar para el trabajo de cada día.',
  more: 'Explora la app', comic: 'Lee los cómics', proof: 'Creada por un exmarine de EE. UU.',
  plan: 'UN PLAN. UN REGISTRO. TU PROGRESO.', field: 'DENTRO DE GRUNTZ',
  appTitle: 'Tu plan y tu registro de entrenamiento.', appSub: 'Elige una función para ver la pantalla real de la app.',
  screen: 'Captura real de Gruntz', branches: 'Tu rama. Tu entrenamiento.',
  branchesSub: 'Para quienes empiezan, siguen en servicio o simplemente siguen entrenando.',
  founderTitle: 'Creada por un exmarine de EE. UU.', aboutBody: 'Soy exmarine. Creé Gruntz para ayudarme a mí y a otros Marines a mantener la motivación y dejar de adivinar qué entrenar. Elige un programa o crea una sesión, y Gruntz guarda cada serie completada, resultado de prueba y punto de XP en tu historial.',
  note: 'SOBRE GRUNTZ', question: 'Antes de empezar.', faqIntro: 'Lo que necesitas saber para tu próxima sesión.',
  start: 'DESCARGA GRUNTZ', startTitle: 'Elige tu plan en Gruntz.',
  startSub: 'Sigue un programa o crea tu propia rutina. Tu próxima sesión empieza en la app.',
  store: 'Descargar Gruntz', price: `${site.trialDays} días de acceso completo incluidos. Después se requiere una suscripción. Consulta los precios actuales en el App Store.`,
  testNote: 'Las estimaciones de preparación usan tus eventos registrados y objetivos personales. No son puntuaciones oficiales ni garantizan aprobar.',
  quick: ['Planes estructurados', 'Series, repeticiones y descanso', 'XP, rangos y rachas'],
} : {
  issue: 'YOUR DAILY PLAN', intro: 'Military fitness for the work you put in every day.',
  more: 'Explore the app', comic: 'Read the comics', proof: 'Built by a former U.S. Marine',
  plan: 'A PLAN. A LOG. YOUR PROGRESS.', field: 'INSIDE GRUNTZ',
  appTitle: 'Your plan and workout log.', appSub: 'Choose a feature to see the actual app screen.',
  screen: 'Actual Gruntz app screen', branches: 'Your branch. Your training.',
  branchesSub: 'For the people getting started, still serving, or simply still showing up.',
  founderTitle: 'Built by a former U.S. Marine.', aboutBody: 'I’m a former Marine. I built Gruntz to help me and other Marines stay motivated and stop guessing what to train. Pick a program or build a workout, and Gruntz keeps every completed set, test-event result, and XP point in your history.',
  note: 'ABOUT GRUNTZ', question: 'Before you get after it.', faqIntro: 'A few things to know before your first session.',
  start: 'GET GRUNTZ', startTitle: 'Choose your plan in Gruntz.',
  startSub: 'Follow a program or build your own. Your next session starts in the app.',
  store: 'Download Gruntz', price: `${site.trialDays} days of full access included. Subscription required afterward. See the App Store for current pricing.`,
  testNote: 'Preparation estimates use your logged events and personal targets. They are not official scores or a guarantee of passing.',
  quick: ['Structured training plans', 'Sets, reps & rest', 'XP, ranks & streaks'],
};
const people = es ? {
  title: 'Militar o no, el plan es el mismo.',
  sub: 'Gruntz tiene perfiles para las seis ramas y planes de entrenamiento general para quien nunca ha servido.',
  cards: [
    { chip: 'Reclutas y aspirantes', title: 'Construye tu base antes del entrenamiento básico', copy: 'Sesiones estructuradas para el entrenamiento básico, la escuela de oficiales o una selección, con un registro de tu progreso.', photo: '/photos/p08-900.webp', alt: 'Reclutas sentados en fila haciendo abdominales en la playa', pos: '50% 35%' },
    { chip: 'Militares en servicio', title: 'Ten presente tu próxima prueba física', copy: 'Guarda resultados de tus pruebas, compara controles de progreso e identifica la mayor diferencia respecto a tu objetivo.', photo: '/photos/p01-900.webp', alt: 'Hombre con pantalón de camuflaje junto a una barra con pesas al aire libre', pos: '50% 50%' },
    { chip: 'Veteranos', title: 'Sigue entrenando después de salir', copy: 'Sigue un programa o crea tus propias sesiones. Tu historial, tus rachas y tu rango siguen contigo.', photo: '/photos/p84-900.webp', alt: 'Atleta haciendo dominadas en un gimnasio oscuro', pos: '50% 30%' },
    { chip: 'Civiles', title: 'Sin servicio previo', copy: 'Elige un plan para tu equipo y tu horario. Los planes de entrenamiento general no requieren experiencia militar.', photo: '/photos/p68-900.webp', alt: 'Atleta en posición de salida de sprint en un parque', pos: '50% 40%' },
  ],
} : {
  title: 'Military or not, the plan works the same.',
  sub: 'Gruntz has profiles for all six branches, plus general training plans for people who never served.',
  cards: [
    { chip: 'Recruits & candidates', title: 'Build your base before boot camp', copy: 'Structured sessions for basic training, OCS, or selection prep, with a record of every workout.', photo: '/photos/p08-900.webp', alt: 'Recruits sitting in a line doing sit-ups on a beach', pos: '50% 35%' },
    { chip: 'Service members', title: 'Keep your next PT test in view', copy: 'Save test-event results, compare progress checks, and see your biggest logged gap to a target.', photo: '/photos/p01-900.webp', alt: 'Man in camouflage pants beside a loaded barbell outdoors', pos: '50% 50%' },
    { chip: 'Veterans', title: 'Keep training after you get out', copy: 'Follow a program or build your own workouts. Your history, streaks, and rank stay with you.', photo: '/photos/p84-900.webp', alt: 'Athlete doing pull-ups in a dark gym', pos: '50% 30%' },
    { chip: 'Civilians', title: 'No service required', copy: 'Pick a plan for your equipment and schedule. General training plans need no military background.', photo: '/photos/p68-900.webp', alt: 'Athlete in a sprint start position in a park', pos: '50% 40%' },
  ],
};
const branches = ['Army', 'Marine Corps', 'Navy', 'Air Force', 'Space Force', 'Coast Guard'];
const featureData = { features: t.features.map(f => ({name:f.name,headline:f.headline,copy:f.copy,screen:f.screen})), counter:t.featuresHead.counter, screenAlt:t.featuresHead.screenAlt };
const jsonLd = { '@context':'https://schema.org', '@type':'SoftwareApplication', name:'Gruntz: Military Fitness & PT', operatingSystem:'iOS', applicationCategory:'HealthApplication', inLanguage:lang, description:t.meta.description, url:site.url, downloadUrl:site.appStoreUrl, isAccessibleForFree:false };
---
<BaseLayout lang={lang} title={t.meta.title} description={t.meta.description} ogLocale={t.meta.ogLocale}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
  <Header lang={lang} />
  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="site-shell hero-grid">
        <div class="hero-copy">
          <p class="eyebrow"><span class="status-dot"></span>{t.hero.eyebrow}</p>
          <h1 id="hero-title">{es ? 'Tu misión diaria ' : 'Your daily mission '}<span>{es ? 'está lista.' : 'is ready.'}</span></h1>
          <p class="hero-lede">{t.hero.lede}</p>
          <div class="hero-actions">
            <a class="button button-primary" href={site.appStoreUrl} target="_blank" rel="noopener" data-cta="hero">{c.store}<span aria-hidden="true">↗</span></a>
            <a class="text-link" href="#features">{c.more}<span aria-hidden="true">↓</span></a>
          </div>
          <p class="access-note">{t.hero.priceNote}</p>
          <div class="founder-proof"><img class="proof-mark" src="/brand/gruntz-icon.png" width="32" height="32" alt="" /><span>{c.proof}</span></div>
        </div>
        <div class="hero-visual">

          <div class="hero-comic" aria-hidden="true">
            <div class="comic-paper-label"><span>GRUNTZ COMICS</span><span>ARMY</span></div>
            <img src="/comics/army-1600.webp" width="1600" height="728" alt="" fetchpriority="high" />
            <div class="paper-punchline">{es ? '¿Cuál es el plan?' : 'WHAT’S THE PLAN?'}</div>
          </div>
          <div class="hero-phone phone"><div class="phone-screen"><img src="/app/train-current.webp" width="402" height="874" alt={es ? 'Pantalla real del plan de entrenamiento de Gruntz' : 'Genuine Gruntz daily training plan screen'} loading="eager" /></div></div>
          <a class="comic-teaser" href="#comics"><svg class="teaser-icon" width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 5h20v14H11l-5 4v-4H4z"/><path d="M8 10h12M8 14h8"/></svg><span>{c.comic}<small>{es ? 'Una tira para cada rama' : 'One strip for each branch'}</small></span><span aria-hidden="true">↓</span></a>
        </div>
      </div>
    </section>

    <section class="branch-band" aria-label={es ? 'Seis ramas militares de EE. UU.' : 'Six U.S. military branches'}>
      <div class="site-shell branch-inner"><span class="branch-intro">{es ? 'PARA LAS SEIS RAMAS' : 'FOR ALL SIX BRANCHES'}</span><ul>{branches.map(branch=><li>{branch}</li>)}</ul></div>
    </section>


    <section class="people section" id="who" aria-labelledby="people-title">
      <div class="site-shell">
        <div class="people-head"><h2 id="people-title">{people.title}</h2><p>{people.sub}</p></div>
        <ul class="people-grid">
          {people.cards.map(p => <li class="people-card"><div class="people-photo"><img src={p.photo} alt={p.alt} width="900" height="600" loading="lazy" decoding="async" style={`object-position:${p.pos}`} /><span class="people-chip">{p.chip}</span></div><h3>{p.title}</h3><p>{p.copy}</p></li>)}
        </ul>
      </div>
    </section>

    <section class="app-section section" id="features" aria-labelledby="app-title">
      <div class="site-shell">
        <div class="section-top"><div><h2 id="app-title">{c.appTitle}</h2></div><p>{c.appSub}</p></div>
        <div class="app-grid">
          <div class="feature-list"><div role="tablist" aria-label={t.featuresHead.tablistLabel} aria-orientation="vertical" id="feature-tabs" data-features={JSON.stringify(featureData)}>
            {t.features.map((f,i)=><button class="feature-tab" role="tab" id={`tab-${i}`} aria-selected={i===0?'true':'false'} aria-controls="feature-panel" tabindex={i===0?0:-1}><span class="feature-number">{String(i+1).padStart(2,'0')}</span><span><strong>{f.name}</strong><small>{f.short}</small></span></button>)}
          </div></div>
          <div class="feature-stage" id="feature-panel" role="tabpanel" aria-labelledby="tab-0" tabindex="0">

            <div class="feature-copy"><span class="eyebrow" id="feature-count">{t.featuresHead.counter} 01</span><h3 id="feature-headline">{t.features[0].headline}</h3><p id="feature-text">{t.features[0].copy}</p></div>
            <div class="phone feature-phone"><div class="phone-screen"><img id="feature-screen" src={t.features[0].screen} alt={`${t.features[0].name} ${t.featuresHead.screenAlt}`} width="402" height="874" loading="lazy" /></div></div>
          </div>
        </div>
        <p class="test-note">{c.testNote}</p>
      </div>
    </section>

    <ComicGallery lang={lang} />

    <section class="field-note section" id="about">
      <div class="site-shell field-grid">
        <div class="field-photo"><Image src={fieldPhoto} alt={es ? 'Entrenamiento al aire libre con una mochila' : 'Outdoor training with a rucksack'} width={800} height={1000} widths={[400, 800, 1200]} sizes="(max-width: 650px) calc(100vw - 40px), 50vw" format="webp" quality={80} loading="lazy" /></div>
        <div class="field-copy"><h2>{c.founderTitle}</h2><p>{c.aboutBody}</p><div class="founder-signature"><img src="/brand/gruntz-icon.png" width="44" height="44" alt="" /><div><strong>{es ? 'App de fitness independiente' : 'Independent fitness app'}</strong><span>{t.founder.note}</span></div></div></div>
      </div>
    </section>

    <section class="faq-section section" id="faq">
      <div class="site-shell faq-grid"><div><p class="eyebrow">FAQ</p><h2>{c.question}</h2><p class="faq-intro">{c.faqIntro}</p><a class="text-link" href="/support">{t.nav.support}<span aria-hidden="true">→</span></a></div><div class="faq">{t.faq.map(f=><details><summary>{f.q}<span aria-hidden="true">+</span></summary><p>{f.a}</p></details>)}</div></div>
    </section>

    <section class="final-cta" id="download"><div class="site-shell final-grid"><div><h2>{c.startTitle}</h2><p>{c.startSub}</p></div><div class="download-panel"><div class="download-app"><img src="/brand/gruntz-icon.png" width="58" height="58" alt="" /><div><strong>Gruntz</strong><span>{es ? 'Fitness militar y registro de entrenamientos' : 'Military fitness & workout log'}</span></div></div><a class="store-badge" href={site.appStoreUrl} target="_blank" rel="noopener" data-cta="footer"><img src="/brand/app-store-badge.svg" alt={t.hero.badgeAlt} width="162" height="54" /></a><small>{c.price}</small></div></div></section>
  </main>
  <Footer lang={lang} />
  <script src="../scripts/home.ts"></script>
</BaseLayout>
