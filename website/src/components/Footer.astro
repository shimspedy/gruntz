---
import { site } from '../data/site';
import { content, localePath, type Lang } from '../i18n/content';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props as Props;
const t = content[lang].footer;
---

<footer class="site-footer">
  <div class="site-shell footer-grid">
    <div class="footer-brand">
      <a class="brand-lockup" href={localePath(lang, '/')} aria-label="Gruntz">
        <img src="/brand/gruntz-icon.png" alt="" width="32" height="32" />
        <span>Gruntz</span>
      </a>
      <p>{t.tagline} {t.disclaimer}</p>
    </div>

    <nav class="footer-links" aria-label="Footer">
      <a href={site.appStoreUrl} target="_blank" rel="noopener">{t.appStore}</a>
      <a href="/support">{t.support}</a>
      <a href="/privacy-policy">{t.privacy}</a>
      <a href="/terms-of-use">{t.terms}</a>
      <a href={`mailto:${site.supportEmail}`}>{t.contact}</a>
    </nav>
  </div>

  <div class="site-shell footer-meta">
    <span>&copy; 2026 {site.name}</span>
    <span>{t.photos}</span>
  </div>
</footer>
