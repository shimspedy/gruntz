---
import { site } from '../data/site';
import { content, localePath, type Lang } from '../i18n/content';
import { testGuides, trainingGuides, guidePath } from '../data/guides';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props as Props;
const t = content[lang].footer;
const nav = content[lang].nav;
const es = lang === 'es';

const columns = [
  {
    title: 'Gruntz',
    links: [
      { label: t.appStore, href: site.appStoreUrl, external: true },
      { label: nav.features, href: localePath(lang, '/#features') },
      { label: es ? 'Cómics' : 'Comics', href: localePath(lang, '/#comics') },
      { label: nav.faq, href: localePath(lang, '/#faq') },
    ],
  },
  {
    title: es ? 'Pruebas físicas' : 'Fitness tests',
    links: [
      { label: es ? 'Todas las pruebas' : 'All six branches', href: '/fitness-tests/' },
      ...testGuides.map((g) => ({ label: g.name, href: guidePath(g) })),
    ],
  },
  {
    title: es ? 'Entrenamiento' : 'Training',
    links: [
      { label: es ? 'Todas las guías' : 'All guides', href: '/training/' },
      ...trainingGuides.map((g) => ({ label: g.name, href: guidePath(g) })),
    ],
  },
  {
    title: es ? 'Ayuda' : 'Help',
    links: [
      { label: t.support, href: '/support' },
      { label: t.privacy, href: '/privacy-policy' },
      { label: t.terms, href: '/terms-of-use' },
      { label: t.contact, href: `mailto:${site.supportEmail}` },
    ],
  },
];
---

<footer class="border-t border-bone/10 bg-ink">
  <div class="shell grid gap-12 py-16 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-16">
    <div>
      <a class="flex items-center gap-2.5" href={localePath(lang, '/')} aria-label="Gruntz">
        <img src="/brand/gruntz-icon.png" alt="" width="32" height="32" class="size-8 rounded-lg" loading="lazy" />
        <span class="display text-lg">Gruntz</span>
      </a>
      <p class="mt-5 max-w-[38ch] text-[15px] leading-relaxed text-bone-2">{t.tagline}</p>
      <p class="mt-3 max-w-[44ch] text-sm leading-relaxed text-bone-3">{t.disclaimer}</p>
    </div>

    <div class="grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-4">
      {columns.map((col) => (
        <nav aria-label={col.title}>
          <p class="stamp">{col.title}</p>
          <ul class="mt-4 grid gap-1">
            {col.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={'external' in link && link.external ? '_blank' : undefined}
                  rel={'external' in link && link.external ? 'noopener' : undefined}
                  class="inline-flex min-h-8 items-center text-[15px] text-bone-2 transition-colors duration-150 ease-out hover:text-bone"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
  </div>

  <div class="border-t border-bone/10">
    <div class="shell flex flex-col gap-3 py-6 text-[13px] leading-5 text-bone-3 md:flex-row md:justify-between md:gap-12">
      <span class="shrink-0">&copy; 2026 {site.name}</span>
      <span class="max-w-[92ch] md:text-right">{t.photos}</span>
    </div>
  </div>
</footer>
