---
import { site } from '../data/site';
---

<footer class="site-footer">
  <div class="site-shell footer-grid">
    <div class="footer-brand">
      <a class="brand-lockup" href="/" aria-label="Gruntz home">
        <img src="/brand/gruntz-icon.png" alt="" width="32" height="32" />
        <span>Gruntz</span>
      </a>
      <p>{site.tagline} Not affiliated with or endorsed by the U.S. Department of Defense or any military branch.</p>
    </div>

    <nav class="footer-links" aria-label="Footer">
      <a href={site.appStoreUrl} target="_blank" rel="noopener">App Store</a>
      <a href="/support">Support</a>
      <a href="/privacy-policy">Privacy Policy</a>
      <a href="/terms-of-use">Terms of Use</a>
      <a href={`mailto:${site.supportEmail}`}>Contact</a>
    </nav>
  </div>

  <div class="site-shell footer-meta">
    <span>&copy; 2026 {site.name}</span>
    <span>Photos: Unsplash</span>
  </div>
</footer>
